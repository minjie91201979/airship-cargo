{
  "name": "airship-cargo",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "npm run build && node tools/dist-win.mjs",
    "sim": "npx -y tsx tools/balance-sim.ts",
    "dist:win:direct": "npm run build && electron-builder --win portable nsis --x64"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "description": "云港航运 · 蒸汽朋克飞艇货运",
  "author": "大王",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.dawang.airshipcargo",
    "productName": "AirshipCargo",
    "copyright": "大王",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "electron/icon.ico",
      "artifactName": "YunGang-AirshipCargo-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "AirshipCargo-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "云港航运",
      "artifactName": "AirshipCargo-${version}-setup.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
